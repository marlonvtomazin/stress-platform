        {
          "query": "from(bucket: \"${bucket}\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"vus\")\r\n  |> filter(fn: (r) => r._field == \"value\")\r\n  |> filter(fn: (r) => r.execution_id == \"${execution_id}\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\r\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\r\n  |> set(key: \"_field\", value: \"Active VUs\")",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "bfwlaoe6kp1j4b"
          },
          "hide": false,
          "query": "from(bucket: \"${bucket}\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"http_reqs\")\r\n  |> filter(fn: (r) => r._field == \"value\")\r\n  |> filter(fn: (r) => r.execution_id == \"${execution_id}\")\r\n  // Junta todas as séries (status, url, método, etc.)\r\n  |> group(columns: [\"execution_id\"])\r\n  // Soma as requisições por segundo\r\n  |> aggregateWindow(every: 1s, fn: sum, createEmpty: false)\r\n  |> keep(columns: [\"_time\", \"_value\"])\r\n  |> set(key: \"_field\", value: \"Throughput\")",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "bfwlaoe6kp1j4b"
          },
          "hide": false,
          "query": "from(bucket: \"${bucket}\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"http_req_duration\")\r\n  |> filter(fn: (r) => r._field == \"value\")\r\n  |> filter(fn: (r) => r.execution_id == \"${execution_id}\")\r\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\r\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])\r\n  |> set(key: \"_field\", value: \"Response Time\")",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "bfwlaoe6kp1j4b"
          },
          "hide": false,
          "query": "from(bucket: \"${bucket}\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"http_reqs\")\r\n  |> filter(fn: (r) => r._field == \"value\")\r\n  |> filter(fn: (r) => r.execution_id == \"${execution_id}\")\r\n  |> filter(fn: (r) => int(v: r.status) >= 400)\r\n\r\n  |> group(columns: [\"execution_id\"])\r\n\r\n  // Conta erros por segundo\r\n  |> aggregateWindow(every: 1s, fn: count, createEmpty: true)\r\n\r\n  // Segundos sem erro = 0\r\n  |> fill(column: \"_value\", value: 0)\r\n\r\n  |> keep(columns: [\"_time\", \"_value\"])\r\n  |> set(key: \"_field\", value: \"Failed Requests/sec\")",
          "refId": "D"
        }
